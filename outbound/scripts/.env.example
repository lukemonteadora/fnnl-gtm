# =============================================================================
# FNNL AGENCY — ENVIRONMENT TEMPLATE
# =============================================================================
#
# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is gitignored. NEVER commit real secrets, and never paste a key
# into chat.
#
# STACK RECORDED 2026-09-18 by /stack-setup, NARROWED 2026-09-22 by operator
# directive to FNNL's approved six: GetLeads, AI Ark, Prospeo, Giggal,
# Clay and PlusVibe (stack-contract.yaml `approved_stack`).
# The ACTIVE keys at the bottom of this file are EXACTLY the ones those six
# need, plus ONE approved exception: OPENAI_API_KEY, OpenAI, headshots only,
# asked for at infrastructure setup (see "AI" below). Keys for tools held outside the six are commented out. They come from
# `credential-registry.json`. If a tool is not listed here, it is not in
# FNNL's contract, and a skill that wants it must stop and ask rather than
# assume one.
#
# NAMES ONLY IN THIS FILE. It is tracked by git. Real values go in `.env`,
# which is gitignored, and never into chat.
#
# =============================================================================


# ── Run identity (per client, set before an infrastructure run) ──────────────
# These describe the client you are currently building for, not a tool choice.

CLIENT_NAME=
BRAND_KEYWORD=
SENDER_FIRST_NAME=
SENDER_LAST_NAME=

# Domain + mailbox volume for this client's infrastructure run.
DOMAIN_COUNT=
INBOXES_PER_DOMAIN=
TLD=com
MAX_PRICE_USD=

# Optional exact domain candidates. If omitted, candidates are generated
# from BRAND_KEYWORD.
# DOMAIN_CANDIDATES=


# ── Stack selections (filled by /stack-setup from stack-contract.yaml) ───────
# These must match the tools recorded in
# outbound/stack-contract.yaml. A blank value makes the skills stop and ask,
# which is the intended behavior. A guessed value is worse than a blank one.

# REGISTRAR and MAILBOX_PROVIDER are BLANK on purpose: Dynadot and ScaledMail
# are held outside the approved six (contract status `held`), and email infra
# is deferred by the operator. Blank makes the skills stop and ask.
REGISTRAR=
MAILBOX_PROVIDER=
SENDING_PLATFORM=Plusvibe.ai

# Non-email channel. Leave blank for email-only clients.
# NOTE: unlike the three above, NO script reads this yet. It mirrors
# stack-contract.yaml channels.linkedin_outreach for human reference only.
# BLANK on purpose: HeyReach is held outside the approved six.
LINKEDIN_OUTREACH=

# Mailbox provider plan. Required for live runs. Derive from
# /mailbox-mix-strategy. Do not use a silent default.
PROVIDER_PLAN=

# Google Workspace vs Microsoft 365 split, as domain index ranges.
# Derived from /mailbox-mix-strategy.
# GOOGLE_DOMAINS=
# MICROSOFT_DOMAINS=


# ── Safety ──────────────────────────────────────────────────────────────────

# Set true to verify config paths without spending money.
# Preflight still calls read-only endpoints.
DRY_RUN=true


# =============================================================================
# TOOL CREDENTIALS
# =============================================================================
#
# Exactly the keys FNNL's approved six need, as of 2026-09-22, plus the one
# headshot exception (OPENAI_API_KEY, blank until infrastructure setup).
# NAMES ONLY HERE. Put real values in `.env`, which is gitignored.
#
# Nothing below has been verified against an FNNL account yet. Every slot in
# stack-contract.yaml is `chosen`, not `live`. After filling `.env`:
#   1. Run `/preflight-credentials` to confirm the keys resolve and look sane.
#   2. Make ONE real call per tool.
#   3. Only then set that slot to `live` in stack-contract.yaml.
#
# =============================================================================


# ── Sending platform (required: a run fails without these) ──────────────────

# Plusvibe.ai, sending platform. BOTH values are required: every endpoint
# takes workspace_id as a parameter, so the key alone will not work.
# API access requires their BUSINESS plan (77 USD/mo minimum).
PLUSVIBE_API_KEY=
PLUSVIBE_WORKSPACE_ID=


# ── Lead data ───────────────────────────────────────────────────────────────

# AI Ark. Primary company discovery, contact discovery, and step 1 of the
# email-reveal waterfall. Effectively required for any list build.
AI_ARK_API_KEY=

# Prospeo. Gap-fill ONLY on rows AI Ark left blank or Giggal rejected.
# Read its `verification_method` field, not `status` alone: `status` is binary
# and collapses catch-all into valid.
PROSPEO_API_KEY=

# Giggal. THE email verifier of record (operator directive 2026-10-12, replacing
# MillionVerifier, which had replaced LeadMagic), run between every waterfall
# stage. Returns accept_all/risky as its own result, which /email-waterfall's
# Catch-All Timing gate needs. Reachable through the local MCP server
# outbound/scripts/mcp/giggal_mcp.mjs, which reads this key itself, so nothing
# goes into the tracked .mcp.json. Bills 1 credit per verification (unknown is
# refunded). Key shape: tp_live_... sent only as a Bearer header.
# Set it with: powershell -ExecutionPolicy Bypass -File outbound/scripts/setup-giggal-key.ps1
GIGGAL_API_KEY=

# GetLeads needs NO key here. It authenticates by OAuth through its MCP
# connector. Authorize it in the MCP connector settings instead.


# ── Lead-list workbench ─────────────────────────────────────────────────────

# Clay. The visible sheet the working lead list lives on. REST base
# https://api.clay.com/public/v0, header clay-api-key.
# FNNL's workspace is Dorsia Labs (651677), confirmed 2026-09-22. Never build a
# client list in a-sales.co (161971), the previous company's workspace.
# Zero Clay credits, ever: stack-contract.yaml lead_data.list_workbench.credit_policy_rule.
# Rows reach a client table through its inbound webhook (URL kept in the client's
# gitignored profile, not here), which needs no API key.
CLAY_API_KEY=


# ── AI (no-AI-API rule, operator directive 2026-09-22) ───────────────────────

# The only AI is Claude Code itself: the session, its sub-agents, the
# /deep-research harness, and its built-in WebSearch and WebFetch. Research,
# bulk classification, copy and web search/crawl all run there and need NO
# key. Do not add any AI-provider key to this file.

# THE ONE EXCEPTION: OpenAI, headshots only, asked for at infrastructure setup.
# Used only by /mailbox-profile-generator (generate_inbox_profiles.py, model
# gpt-image-1) for the sender persona headshot. Leave it blank until the
# headshot step runs or the operator says to start setting up cold-email
# infrastructure. /preflight-credentials treats it as not needed yet and never
# flags it at onboarding, intake, kickoff, preflight or stack setup.
OPENAI_API_KEY=


# =============================================================================
