#   DYNADOT_API_SECRET=
#   ScaledMail, mailbox provider (async 24-72h fulfilment):
#   SCALEDMAIL_API_KEY=
#   HeyReach, LinkedIn channel (300 req/min shared org-wide):
#   HEYREACH_API_KEY=
#
# RETIRED 2026-09-22 (no-AI-API rule): Parallel.ai (research, web search and
# crawl) and every other AI-provider key. Do not re-add them.
#
# REPLACED 2026-09-22: LeadMagic (verifier of record 2026-09-18 to 2026-09-22).
#   LEADMAGIC_API_KEY=
#
# NO TOOL CHOSEN:
#   crm                 - no tool chosen.
#   reporting_destination - no tool chosen.
#   spreadsheet         - no tool chosen; /mailbox-pool-staging is blocked
#                         until one exists and its two sheet IDs are filled.
#
# =============================================================================
