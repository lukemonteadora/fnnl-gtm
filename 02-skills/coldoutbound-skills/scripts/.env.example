# =============================================================================
# FNNL AGENCY — ENVIRONMENT TEMPLATE
# =============================================================================
#
# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is gitignored. NEVER commit real secrets, and never paste a key
# into chat.
#
# THIS FILE SHIPS WITH NO TOOL KEYS ON PURPOSE.
# FNNL Agency has not chosen a tech stack yet. Run `/stack-setup` to record
# the real tools; it will add exactly the credential names the chosen stack
# needs, pulled from `credential-registry.json`, and nothing else.
#
# Do not uncomment a block below just because the tool looks familiar. A key
# present here implies the system will use that tool, which is exactly the
# assumption this workspace is built to avoid.
#
# =============================================================================


# ── Run identity (per client, set before an infrastructure run) ──────────────
# These describe the client you are currently building for, not a tool choice.

CLIENT_NAME=
BRAND_KEYWORD=
SENDER_FIRST_NAME=
SENDER_LAST_NAME=

# Domain + mailbox volume for this client's infrastructure run.
DOMAIN_COUNT=
INBOXES_PER_DOMAIN=
TLD=com
MAX_PRICE_USD=

# Optional exact domain candidates. If omitted, candidates are generated
# from BRAND_KEYWORD.
# DOMAIN_CANDIDATES=


# ── Stack selections (filled by /stack-setup from stack-contract.yaml) ───────
# These must match the tools recorded in
# 02-skills/coldoutbound-skills/stack-contract.yaml. Leave blank until the
# contract is filled. A blank value makes the skills stop and ask, which is
# the intended behavior. A guessed value is worse than a blank one.

REGISTRAR=
MAILBOX_PROVIDER=
SENDING_PLATFORM=

# Mailbox provider plan. Required for live runs. Derive from
# /mailbox-mix-strategy. Do not use a silent default.
PROVIDER_PLAN=

# Google Workspace vs Microsoft 365 split, as domain index ranges.
# Derived from /mailbox-mix-strategy.
# GOOGLE_DOMAINS=
# MICROSOFT_DOMAINS=


# ── Safety ──────────────────────────────────────────────────────────────────

# Set true to verify config paths without spending money.
# Preflight still calls read-only endpoints.
DRY_RUN=true


# =============================================================================
# TOOL CREDENTIALS
# =============================================================================
#
# Deliberately empty.
#
# `/stack-setup` appends the required keys here once FNNL's tools are chosen.
# `credential-registry.json` in this folder catalogues the exact env var
# name(s) for 35 known providers, so the names do not have to be guessed.
#
# After adding keys:
#   1. Put the real values in `.env`, never in this file.
#   2. Run `/preflight-credentials` to confirm they resolve.
#   3. Make one real call before marking the slot `live` in the contract.
#
# =============================================================================
